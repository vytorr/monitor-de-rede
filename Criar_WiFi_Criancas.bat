@echo off
title Criar Wi-Fi dos Filhos - Modo Facil

echo ============================================================
echo      CONECTAR O CELULAR DOS FILHOS PELO WI-FI DO PC
echo ============================================================
echo.
echo Esta e a forma que funciona de verdade: o computador cria uma
echo rede Wi-Fi propria. Ao conectar o celular do seu filho nela, o
echo monitoramento funciona na hora, sem mexer em nada no celular.
echo.
echo Abrindo as configuracoes de Ponto de acesso movel do Windows...
start ms-settings:network-mobilehotspot
echo.
echo ============================================================
echo   1. Na janela que abriu, ATIVE a chave "Ponto de acesso movel".
echo   2. Anote o NOME da rede e a SENHA que aparecem.
echo   3. Conecte o celular do seu filho nessa rede.
echo   4. Pronto! O Monitor ja comeca a registrar.
echo ============================================================
echo.
pause
